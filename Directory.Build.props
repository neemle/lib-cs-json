<Project>
  <PropertyGroup Condition="'$(BaseIntermediateOutputPath)' == ''">
    <_JsonRepoRoot>$(MSBuildThisFileDirectory)</_JsonRepoRoot>
    <_ProjectRelativePath
      >$([System.IO.Path]::GetRelativePath('$(_JsonRepoRoot)', '$(MSBuildProjectDirectory)'))</_ProjectRelativePath>
    <BaseIntermediateOutputPath
      >$(_JsonRepoRoot).dev-temp/obj/$(_ProjectRelativePath)/$(MSBuildProjectName)/</BaseIntermediateOutputPath>
    <BaseOutputPath Condition="'$(BaseOutputPath)' == ''"
      >$(_JsonRepoRoot).dev-temp/bin/$(_ProjectRelativePath)/$(MSBuildProjectName)/</BaseOutputPath>
  </PropertyGroup>
  <PropertyGroup>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <MSBuildTreatWarningsAsErrors>true</MSBuildTreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <ProvideCommandLineArgs>true</ProvideCommandLineArgs>
    <EmitCompilerGeneratedFiles>true</EmitCompilerGeneratedFiles>
    <UseSharedCompilation>false</UseSharedCompilation>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <DefaultItemExcludes>$(DefaultItemExcludes);**/obj/**;**/bin/**;**/.dev-temp/**</DefaultItemExcludes>
  </PropertyGroup>
</Project>
