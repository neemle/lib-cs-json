<Project>
  <!-- This prototype changes the executable operation before analysis; it does
       not suppress diagnostics on either the original or generated program. -->
  <PropertyGroup Condition="'$(PublishAot)' == 'true' Or '$(NeemleJsonInferOrdinaryCalls)' == 'true'">
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Neemle.SystemTextJson.Generated</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <CompilerVisibleProperty Include="PublishAot" />
    <CompilerVisibleProperty Include="NeemleJsonInferOrdinaryCalls" />
  </ItemGroup>
  <Target Name="UseExecutableJsonContractAnalyzer" BeforeTargets="CoreCompile"
          Condition="'$(PublishAot)' == 'true' Or '$(NeemleJsonInferOrdinaryCalls)' == 'true'">
    <PropertyGroup>
      <NeemleJsonContractAnalyzer Condition="'$(NeemleJsonContractAnalyzer)' == ''">$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../tools/InterceptionAwareAnalyzer/bin/$(Configuration)/net10.0/Neemle.SystemTextJson.AotAnalysis.dll'))</NeemleJsonContractAnalyzer>
    </PropertyGroup>
    <Error Condition="!Exists('$(NeemleJsonContractAnalyzer)')" Text="Build the source-owned executable-contract analyzer before compiling inferred ordinary JSON operations." />
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'ILLink.RoslynAnalyzer' Or '%(Analyzer.Filename)' == 'Neemle.SystemTextJson.AotAnalysis'" />
      <Analyzer Include="$(NeemleJsonContractAnalyzer)" />
    </ItemGroup>
  </Target>
</Project>
