<Project>
  <Import Project="UseSourceLibrary.targets" />
  <!-- Source consumers build the generator through ProjectReference. Keep the
       SDK's bundled generator from running a second time over the same context. -->
  <Target Name="UseLocallyBuiltJsonSourceGenerator" BeforeTargets="CoreCompile">
    <PropertyGroup>
      <_LocalJsonSourceGenerator>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../src/System.Text.Json.SourceGeneration/bin/$(Configuration)/net10.0/System.Text.Json.SourceGeneration.dll'))</_LocalJsonSourceGenerator>
    </PropertyGroup>
    <Error Condition="!Exists('$(_LocalJsonSourceGenerator)')" Text="Build the source-generator project before compiling a JSON source consumer." />
    <ItemGroup>
      <Analyzer Remove="@(Analyzer)" Condition="'%(Analyzer.Filename)' == 'System.Text.Json.SourceGeneration'" />
      <Analyzer Include="$(_LocalJsonSourceGenerator)" />
    </ItemGroup>
  </Target>
  <Target Name="KeepSourceJsonProjectReference" AfterTargets="AddPrunePackageReferences">
    <!-- This is the actual framework library replacement, so it must remain
         a project input rather than becoming a pruned framework package. -->
    <ItemGroup><PrunePackageReference Remove="System.Text.Json" /></ItemGroup>
  </Target>
</Project>
