<Project>
  <!-- A framework reference normally wins an identity conflict with a project
       named System.Text.Json. Source-fork consumers intentionally replace that
       single reference with this project's actual implementation. -->
  <Target Name="SelectLocallyBuiltJsonLibrary" AfterTargets="ResolveAssemblyReferences" BeforeTargets="_ComputeReferenceAssemblies;_ComputeUserRuntimeAssemblies;CoreCompile">
    <PropertyGroup>
      <_LocalJsonLibrary>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)../src/System.Text.Json/bin/$(Configuration)/net10.0/System.Text.Json.dll'))</_LocalJsonLibrary>
    </PropertyGroup>
    <Error Condition="!Exists('$(_LocalJsonLibrary)')" Text="Build the local System.Text.Json project before using its implementation." />
    <ItemGroup>
      <ReferencePath Remove="@(ReferencePath)" Condition="'%(ReferencePath.Filename)' == 'System.Text.Json'" />
      <ReferencePathWithRefAssemblies Remove="@(ReferencePathWithRefAssemblies)" Condition="'%(ReferencePathWithRefAssemblies.Filename)' == 'System.Text.Json'" />
      <ReferenceCopyLocalPaths Remove="@(ReferenceCopyLocalPaths)" Condition="'%(ReferenceCopyLocalPaths.Filename)' == 'System.Text.Json'" />
      <ReferencePath Include="$(_LocalJsonLibrary)" CopyLocal="true" Private="true" IncludeRuntimeDependency="true" ReferenceSourceTarget="ResolveAssemblyReference" ResolvedFrom="{HintPathFromItem}" OriginalItemSpec="System.Text.Json" />
      <ReferenceCopyLocalPaths Include="$(_LocalJsonLibrary)" Private="true" />
    </ItemGroup>
  </Target>
  <Target Name="SelectLocallyBuiltJsonNativeLibrary"
          BeforeTargets="NeemleUseNativeQueryable;_NeemleGenerateParameterMetadata;NeemleNativeBootstrapInferOperations;WriteIlcRspFileForCompilation;IlcCompile"
          Condition="'$(PublishAot)' == 'true'">
    <Error Condition="!Exists('$(_LocalJsonLibrary)')" Text="The local serializer implementation is required before native metadata inference." />
    <ItemGroup>
      <IlcReference Remove="@(IlcReference)" Condition="'%(IlcReference.Filename)' == 'System.Text.Json'" />
      <IlcReference Include="$(_LocalJsonLibrary)" />
    </ItemGroup>
  </Target>
</Project>
