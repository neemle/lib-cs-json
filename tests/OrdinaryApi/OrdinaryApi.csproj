<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable><ImplicitUsings>enable</ImplicitUsings><LangVersion>14.0</LangVersion>
    <DebugType>portable</DebugType><EmbedAllSources>true</EmbedAllSources>
    <_TrimmerShowRedundantSuppressions>true</_TrimmerShowRedundantSuppressions>
    <SuppressTrimAnalysisWarnings>false</SuppressTrimAnalysisWarnings><SuppressAotAnalysisWarnings>false</SuppressAotAnalysisWarnings>
  </PropertyGroup>
  <PropertyGroup Condition="'$(PublishAot)' == 'true'">
    <IsAotCompatible>true</IsAotCompatible>
    <RestoreAdditionalProjectSources>$(RestoreAdditionalProjectSources);$(MSBuildThisFileDirectory)../../artifacts/native-feed</RestoreAdditionalProjectSources>
  </PropertyGroup>
  <ItemGroup><ProjectReference Include="../../src/System.Text.Json/System.Text.Json.csproj" Private="true" GlobalPropertiesToRemove="PublishAot;RuntimeIdentifier;SelfContained" /></ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'"><PackageReference Include="Neemle.DBAL.Runtime.NativeBootstrap" Version="10.0.13-neemle.alpha.1.verify.native50.r1" /></ItemGroup>
  <Import Project="../../eng/UseSourceLibrary.targets" />
<Target Name="KeepOrdinarySourceJsonProjectReference" AfterTargets="AddPrunePackageReferences"><ItemGroup><PrunePackageReference Remove="System.Text.Json" /></ItemGroup></Target>
</Project>
