<Project>
  <UsingTask TaskName="Neemle.Json.Generator.BuildRuntimeTask"
             AssemblyFile="$(MSBuildThisFileDirectory)../tools/JsonGenerator.dll" />
  <PropertyGroup>
    <InterceptorsNamespaces>$(InterceptorsNamespaces);Neemle.Json.Interceptors</InterceptorsNamespaces>
  </PropertyGroup>
  <ItemGroup>
    <Analyzer Include="$(MSBuildThisFileDirectory)../tools/JsonGenerator.dll" />
  </ItemGroup>
  <Target Name="NeemleCompilerDependencies" BeforeTargets="CoreCompile" DependsOnTargets="ResolveReferences">
    <ItemGroup>
      <Analyzer Include="@(ReferencePath)" Condition="'%(ReferencePath.NuGetPackageId)' == 'Neemle.CSharpComposer' and
                       '%(ReferencePath.Filename)' == 'Neemle.CSharpComposer'" />
    </ItemGroup>
  </Target>
  <Target Name="NeemleSelectJsonRuntime" BeforeTargets="WriteIlcRspFileForCompilation"
          Condition="'$(PublishAot)' == 'true'">
    <ItemGroup>
      <_NeemleFrameworkJson Include="@(IlcReference)"
                            Condition="'%(IlcReference.Filename)' == 'System.Text.Json'" />
    </ItemGroup>
    <Error Condition="'@(_NeemleFrameworkJson->Count())' != '1'"
           Text="Exactly one framework JSON assembly is required." />
    <PropertyGroup>
      <_NeemleJsonReference>@(_NeemleFrameworkJson)</_NeemleJsonReference>
      <_NeemleRuntimeVersion>$([System.Text.RegularExpressions.Regex]::Replace('$(_NeemleJsonReference)', '^.*[/\\]([0-9]+\.[0-9]+\.[0-9]+)[/\\]runtimes[/\\].*$', '$1'))</_NeemleRuntimeVersion>
      <_NeemleRuntimeDirectory>$([System.IO.Path]::GetFullPath('$(IntermediateOutputPath)NeemleJson/runtime/', '$(MSBuildProjectDirectory)'))</_NeemleRuntimeDirectory>
      <_NeemleRuntimeOutput>$(_NeemleRuntimeDirectory)System.Text.Json.dll</_NeemleRuntimeOutput>
    </PropertyGroup>
    <Error Condition="'$(NeemleJsonRuntimeAssembly)' == '' And !$([System.Text.RegularExpressions.Regex]::IsMatch('$(_NeemleRuntimeVersion)', '^[0-9]+\.[0-9]+\.[0-9]+$'))"
           Text="The .NET runtime version could not be determined." />
    <Neemle.Json.Generator.BuildRuntimeTask Condition="'$(NeemleJsonRuntimeAssembly)' == ''"
      RuntimeVersion="$(_NeemleRuntimeVersion)" OutputFile="$(_NeemleRuntimeOutput)"
      WorkingDirectory="$(_NeemleRuntimeDirectory)" SourceArchive="$(NeemleRuntimeSourceArchive)" />
    <PropertyGroup>
      <NeemleJsonRuntimeAssembly Condition="'$(NeemleJsonRuntimeAssembly)' == ''">$(_NeemleRuntimeOutput)</NeemleJsonRuntimeAssembly>
    </PropertyGroup>
    <Error Condition="!Exists('$(NeemleJsonRuntimeAssembly)')"
           Text="The reflectionless JSON runtime assembly was not built." />
    <ItemGroup>
      <IlcReference Remove="@(_NeemleFrameworkJson)" />
      <IlcReference Include="$(NeemleJsonRuntimeAssembly)" />
    </ItemGroup>
  </Target>
</Project>
