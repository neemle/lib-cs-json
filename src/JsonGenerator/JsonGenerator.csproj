<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Neemle.JSON</PackageId>
    <Version>1.11.3</Version>
    <Authors>Neemle</Authors>
    <Description>Compile-time JSON generation for .NET NativeAOT.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <IncludeBuildOutput>false</IncludeBuildOutput>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Neemle.CSharpComposer" Version="0.5.0" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.Build.Framework" HintPath="$(MSBuildBinPath)/Microsoft.Build.Framework.dll" Private="false" />
    <Reference Include="Microsoft.Build.Utilities.Core" HintPath="$(MSBuildBinPath)/Microsoft.Build.Utilities.Core.dll" Private="false" />
    <Reference Include="Microsoft.CodeAnalysis" HintPath="$(MSBuildBinPath)/Roslyn/bincore/Microsoft.CodeAnalysis.dll" Private="false" />
    <Reference Include="Microsoft.CodeAnalysis.CSharp" HintPath="$(MSBuildBinPath)/Roslyn/bincore/Microsoft.CodeAnalysis.CSharp.dll" Private="false" />
  </ItemGroup>
  <ItemGroup>
    <None Include="Neemle.JSON.targets" Pack="true" PackagePath="buildTransitive/" />
    <None Include="JsonRuntime.patch" Pack="true" PackagePath="tools/" />
    <None Include="JsonRuntime.Net11.patch" Pack="true" PackagePath="tools/" />
    <None Include="$(OutputPath)JsonGenerator.dll" Pack="true" PackagePath="tools/" />
    <None Include="../../README.md" Pack="true" PackagePath="/" />
    <None Include="../../LICENSE.TXT" Pack="true" PackagePath="/" />
    <None Include="$(BaseIntermediateOutputPath)package/_._" Pack="true" PackagePath="lib/net10.0/" />
  </ItemGroup>
  <Target Name="CreatePackagePlaceholder" BeforeTargets="GenerateNuspec">
    <MakeDir Directories="$(BaseIntermediateOutputPath)package" />
    <Touch Files="$(BaseIntermediateOutputPath)package/_._" AlwaysCreate="true" />
  </Target>
</Project>
