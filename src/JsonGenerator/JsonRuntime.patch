index 0000000..8b7d452
--- /dev/null
+++ b/src/libraries/System.Text.Json/src/System/Text/Json/Serialization/StaticTypeMetadata.cs
@@ -0,0 +1,54 @@
+using System.Collections.Generic;
+using System.Text.Json.Serialization.Metadata;
+
+namespace System.Text.Json.Serialization
+{
+    internal static class StaticTypeMetadata
+    {
+        internal const int ValueType = 1;
+        internal const int Class = 2;
+        internal const int Interface = 4;
+        internal const int Abstract = 8;
+        internal const int Sealed = 16;
+        internal const int OverridesToString = 32;
+
+        private const string TypesKey = "Neemle.SystemTextJson.NativeTypeMetadata";
+        private const string PolymorphismKey = "Neemle.SystemTextJson.NativePolymorphism";
+
+        internal static bool HasFlag(Type type, int flag) => (GetTypeInfo(type).Item1 & flag) != 0;
+        internal static string GetName(Type type) => GetTypeInfo(type).Item2;
+        internal static string GetObjectString(object? value)
+        {
+            if (value is null) return "<null>";
+            Type type = value.GetType();
+            return HasFlag(type, OverridesToString) ? value.ToString() ?? string.Empty : GetName(type);
+        }
+        internal static object? NormalizeArgument(object? value) => value is Type type ? GetName(type) : value;
+        internal static object?[] NormalizeArguments(object?[] values)
+        {
+            var result = (object?[])values.Clone();
+            for (int i = 0; i < result.Length; i++) result[i] = NormalizeArgument(result[i]);
+            return result;
+        }
+
+        private static (int, string) GetTypeInfo(Type type)
+        {
+            lock (typeof(JsonSerializer))
+            {
+                if (AppContext.GetData(TypesKey) is Dictionary<Type, (int, string)> types &&
+                    types.TryGetValue(type, out var result)) return result;
+            }
+            throw new NotSupportedException("Static JSON type metadata is missing.");
+        }
+
+        internal static JsonPolymorphismOptions? GetPolymorphism(Type type)
+        {
+            lock (typeof(JsonSerializer))
+            {
+                if (AppContext.GetData(PolymorphismKey) is Dictionary<Type, Func<JsonPolymorphismOptions>?> types &&
+                    types.TryGetValue(type, out var factory)) return factory?.Invoke();
+            }
+            throw new NotSupportedException("Static JSON polymorphism metadata is missing.");
+        }
+    }
+}
