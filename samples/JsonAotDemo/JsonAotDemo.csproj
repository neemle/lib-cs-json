<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <PublishAot>true</PublishAot>
    <JsonSerializerIsReflectionEnabledByDefault>false</JsonSerializerIsReflectionEnabledByDefault>
    <InvariantGlobalization>true</InvariantGlobalization>
    <StaticICULinking>false</StaticICULinking>
    <StaticExecutable>true</StaticExecutable>
    <OptimizationPreference>Size</OptimizationPreference>
    <NeemlePackageVersion Condition="'$(NeemlePackageVersion)' == ''">1.11.1</NeemlePackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Neemle.JSON" Version="$(NeemlePackageVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(PublishAot)' == 'true'">
    <IlcArg Include="--reflectiondata:none" />
  </ItemGroup>
</Project>
